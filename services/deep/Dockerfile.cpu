FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TOKENIZERS_PARALLELISM=false \
    DEEP_ARTIFACT_DIR=/app/artifacts/deep

COPY requirements.cpu.txt /app/requirements.cpu.txt
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch
RUN pip install --no-cache-dir -r /app/requirements.cpu.txt

COPY . /app
RUN mkdir -p /app/artifacts/deep

EXPOSE 8000
CMD ["sh", "-c", "uvicorn db_persistent_compat_app:app --host 0.0.0.0 --port ${PORT:-8000}"]
