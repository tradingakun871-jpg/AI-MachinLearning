FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY requirements.multi-ai.txt /app/requirements.multi-ai.txt
RUN pip install --no-cache-dir -r /app/requirements.multi-ai.txt

COPY app /app/app
COPY multi_ai /app/multi_ai
COPY scripts /app/scripts

EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.multi_ai_main:app --host 0.0.0.0 --port ${PORT:-8000}"]
